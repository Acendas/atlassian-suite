  {
    "name": "allows_jira_get_user_profile",
    "type": "frontmatter_contains",
    "field": "allowed-tools",
    "value": "jira_get_user_profile",
    "_comment": "Assignee is an Atlassian account id, resolved via jira_get_user_profile."
  },
  {
    "name": "resolves_execution_id",
    "type": "contains",
    "pattern": "testCaseExecutionId|execution_id",
    "_comment": "Flow must resolve the execution id, not stop at the cycle map id."
  },
  {
    "name": "documents_assignee_is_account_id",
    "type": "contains",
    "pattern": "account id|account ID|accountId",
    "_comment": "Assignee must be passed as an Atlassian account id, not a display name."
  },
  {
    "name": "requires_read_back_verification",
    "type": "contains",
    "pattern": "(?i)2xx is not proof|read.?back|re-?call .*qmetry_get_execution|confirm.*actually changed",
    "_comment": "A 2xx from QMetry does not prove persistence (the assignee/attachment bugs were silent false-success); the flow must read back to confirm."
  },
  {
    "name": "no_bad_search_executions_project_id_arg",
    "type": "not_contains",
    "pattern": "qmetry_search_executions\\s*\\([^)]*project_id",
    "_comment": "Regression guard: qmetry_search_executions takes test_cycle_id, NOT project_id. The pre-fix skill called it with project_id and could not complete a write."
  },
  {
    "name": "allows_jira_get_issue",
    "type": "frontmatter_contains",
    "field": "allowed-tools",
    "value": "jira_get_issue"
  },
  {
    "name": "has_preflight_check",
    "type": "contains",
    "pattern": "qmetry\\.configured"
  },
  {
    "name": "routes_to_init_when_unconfigured",
    "type": "contains",
    "pattern": "/atlassian-suite:init"
  },
  {
    "name": "auto_resolves_project_id_from_prefix",
    "type": "contains",
    "pattern": "prefix"
  },
  {
    "name": "documents_project_id_identity",
    "type": "contains",
    "pattern": "Jira project ID.*QMetry project ID|QMetry project ID.*Jira project ID",
    "dotall": false
  },
  {
    "name": "shows_linked_requirements",
    "type": "contains",
    "pattern": "requirements?|Covers|traceability",
    "_comment": "Skill must show linked Jira issues for traceability"
  },
  {
    "name": "confirms_before_write",
    "type": "contains",
    "pattern": "(?i)confirm before any write"
  },
  {
    "name": "supports_update_execution_action",
