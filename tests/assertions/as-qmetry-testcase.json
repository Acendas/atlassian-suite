  },
  {
    "name": "no_real_customer_names",
    "type": "not_contains",
    "pattern": "(?:NYW|ventek|venVUE|Caracal|NYWATERWAY|AllClients)"
  },
  {
    "name": "no_real_project_ids",
    "type": "not_contains",
